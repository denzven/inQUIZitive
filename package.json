{
  "name": "inquizitive-pwa",
  "private": true,
  "version": "0.0.0",
  "author": "Denzven <denzven@users.noreply.github.com>",
  "description": "Automated, multi-round quiz software for live events featuring Rapid Fire, Spin Wheel, Tic-Tac-Toe, Speed Buzzer, and Excel imports.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gh-pages": "cross-env VITE_BUILD_TARGET=gh-pages tsc -b && vite build",
    "build:capacitor": "tsc -b && vite build && cap sync",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "tsc -b && vite build && electron-builder --publish never",
    "dist:desktop": "npm run electron:build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@ionic/react": "^8.8.18",
    "@types/jszip": "^3.4.0",
    "html2canvas": "^1.4.1",
    "ionicons": "^8.1.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-pwa": "^1.3.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.inquizitive.app",
    "productName": "inQUIZitive",
    "artifactName": "${productName}-v${version}-${os}-${arch}.${ext}",
    "publish": null,
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/pwa-512x512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "snap",
        "tar.gz"
      ],
      "maintainer": "Denzven <denzven@users.noreply.github.com>",
      "syncDesktopName": true,
      "icon": "public/pwa-512x512.png",
      "category": "Education"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/pwa-512x512.png",
      "category": "public.app-category.education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
